{
  "name": "prode-tafa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:first": "npm test && npm run build && node scripts/check-deploy-schema.mjs && wrangler deploy --secrets-file .dev.vars",
    "deploy": "npm test && npm run build && node scripts/check-deploy-schema.mjs && wrangler deploy",
    "smoke:prod": "node scripts/smoke.mjs",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:e2e": "vite --config vite.e2e.config.ts",
    "test:e2e:local": "node scripts/e2e-t32-local.mjs",
    "db:migrate:e2e": "wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e-t32",
    "check:prod:config": "node scripts/check-production-config.mjs",
    "test:e2e:ci": "node scripts/e2e-t32-ci.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
